@model KhachHang
@{
    ViewData["Title"] = "Sửa khách hàng";
}
<a class="back-link" asp-action="Index"><i class="bi bi-chevron-left"></i> Quản lý khách hàng</a>
<div class="page-head"><div><h1>Sửa khách hàng @UiHelper.MaKH(Model.MaKhachHang)</h1></div></div>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MaKhachHang" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="form-sec" style="max-width:820px">
        <div class="fgrid two">
            <div><label class="flabel">Họ tên *</label><input asp-for="HoTen" class="finput" /><span asp-validation-for="HoTen" class="ferr"></span></div>
            <div><label class="flabel">Số điện thoại *</label><input asp-for="SoDienThoai" class="finput" /><span asp-validation-for="SoDienThoai" class="ferr"></span></div>
            <div><label class="flabel">Email</label><input asp-for="Email" class="finput" /><span asp-validation-for="Email" class="ferr"></span></div>
            <div><label class="flabel">Trạng thái</label><select name="TrangThai" class="fselect"><option value="true" selected="@Model.TrangThai">Hoạt động</option><option value="false" selected="@(!Model.TrangThai)">Ngừng hoạt động</option></select></div>
            <div class="full"><label class="flabel">Địa chỉ</label><input asp-for="DiaChi" class="finput" /><span asp-validation-for="DiaChi" class="ferr"></span></div>
            <div class="full"><label class="flabel">Ghi chú</label><input asp-for="GhiChu" class="finput" /><span asp-validation-for="GhiChu" class="ferr"></span></div>
        </div>
        <div class="d-flex gap-2 mt-3"><button class="btn btn-primary"><i class="bi bi-check2"></i>Lưu thay đổi</button><a class="btn btn-white" asp-action="Index">Hủy</a></div>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
