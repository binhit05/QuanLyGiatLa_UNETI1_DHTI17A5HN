@model SuaDonVM
@{
    ViewData["Title"] = "Chỉnh sửa đơn giặt";
    var d = (DonGiat)ViewBag.Don;
    var nguoi = (List<TaiKhoan>)ViewBag.NguoiTiepNhans;
}
<a class="back-link" asp-action="Details" asp-route-id="@Model.MaDonGiat"><i class="bi bi-chevron-left"></i> Chi tiết đơn @UiHelper.MaDon(d)</a>
<div class="page-head"><div><h1>Chỉnh sửa đơn @UiHelper.MaDon(d)</h1><p>Khách hàng: <b>@d.KhachHang?.HoTen</b> · Tiếp nhận @UiHelper.NgayGio(d.NgayTiepNhan) · Trạng thái @d.TrangThai</p></div></div>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MaDonGiat" />
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <div class="form-sec" style="max-width:820px">
        <div class="fgrid two">
            <div><label class="flabel">Ngày hẹn trả *</label><input type="datetime-local" class="finput" name="NgayHenTra" value="@Model.NgayHenTra.ToString("yyyy-MM-ddTHH:mm")" /><span asp-validation-for="NgayHenTra" class="ferr"></span></div>
            <div>
                <label class="flabel">Người tiếp nhận</label>
                <select asp-for="MaNguoiTiepNhan" class="fselect">@foreach (var t in nguoi) {
                    <option value="@t.MaTaiKhoan">@t.HoTen</option>
                }
            </select>
        </div>
        <div><label class="flabel">Phụ phí (đ)</label><input asp-for="PhuPhi" type="number" min="0" step="any" class="finput" /><span asp-validation-for="PhuPhi" class="ferr"></span></div>
        <div class="full"><label class="flabel">Ghi chú</label><textarea asp-for="GhiChu" class="ftext" rows="3"></textarea><span asp-validation-for="GhiChu" class="ferr"></span></div>
    </div>
    <div class="note-warn mt-3"><i class="bi bi-info-circle"></i><span>Dịch vụ, loại đồ và số lượng không chỉnh sửa tại đây để đảm bảo đúng đơn giá đã áp dụng lúc tiếp nhận. Nếu nhập sai, hãy hủy đơn và tạo đơn mới.</span></div>
    <div class="d-flex gap-2 mt-3"><button class="btn btn-primary"><i class="bi bi-check2"></i>Lưu thay đổi</button><a class="btn btn-white" asp-action="Details" asp-route-id="@Model.MaDonGiat">Hủy</a></div>
</div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
