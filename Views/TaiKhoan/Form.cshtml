@* Họ và tên: Trần Văn Bình | Mã sinh viên: 23103100179 | Nội dung thực hiện: Giao diện trang TaiKhoan/Form. *@
@model TaiKhoanFormVM
@{
    bool moi = Model.MaTaiKhoan == 0;
    ViewData["Title"] = moi ? "Tạo tài khoản" : "Sửa tài khoản";
}
<a class="back-link" asp-action="Index"><i class="bi bi-chevron-left"></i> Quản lý tài khoản</a>
<div class="page-head"><div><h1>@ViewData["Title"]</h1></div></div>
<form asp-action="@(moi ? "Create" : "Edit")" method="post" autocomplete="off">
  <input type="hidden" asp-for="MaTaiKhoan" />
  <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
  <div class="form-sec" style="max-width:820px">
    <div class="fgrid two">
      <div><label class="flabel">Họ tên *</label><input asp-for="HoTen" class="finput" /><span asp-validation-for="HoTen" class="ferr"></span></div>
      <div><label class="flabel">Tên đăng nhập *</label><input asp-for="TenDangNhap" class="finput" /><span asp-validation-for="TenDangNhap" class="ferr"></span></div>
      <div><label class="flabel">Email</label><input asp-for="Email" class="finput" /><span asp-validation-for="Email" class="ferr"></span></div>
      <div><label class="flabel">Vai trò *</label>
        <select asp-for="VaiTro" class="fselect">
          <option value="@VaiTroConst.Admin">Admin</option>
          <option value="@VaiTroConst.NhanVienTiepNhan">Nhân viên tiếp nhận</option>
          <option value="@VaiTroConst.NhanVienXuLy">Nhân viên xử lý</option>
        </select><span asp-validation-for="VaiTro" class="ferr"></span></div>
      <div><label class="flabel">@(moi ? "Mật khẩu *" : "Mật khẩu mới (để trống nếu không đổi)")</label><input asp-for="MatKhau" type="password" class="finput" autocomplete="new-password" /><span asp-validation-for="MatKhau" class="ferr"></span></div>
      <div><label class="flabel">Trạng thái</label><select name="TrangThai" class="fselect"><option value="true" selected="@Model.TrangThai">Hoạt động</option><option value="false" selected="@(!Model.TrangThai)">Đã khóa</option></select></div>
    </div>
    <div class="d-flex gap-2 mt-3"><button class="btn btn-primary"><i class="bi bi-check2"></i>Lưu</button><a class="btn btn-white" asp-action="Index">Hủy</a></div>
  </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
