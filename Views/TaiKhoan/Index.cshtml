@* Họ và tên: Trần Văn Bình | Mã sinh viên: 23103100179 | Nội dung thực hiện: Giao diện trang TaiKhoan/Index. *@
@model PagedList<TaiKhoan>
@{ ViewData["Title"] = "Quản lý tài khoản"; int? toi = Context.Session.LayMaTaiKhoan(); }
<div class="page-head">
  <div><h1>Quản lý tài khoản</h1><p>Phân quyền và kiểm soát quyền truy cập hệ thống.</p></div>
  <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i>Tạo tài khoản</a>
</div>
<div class="panel">
  @await Html.PartialAsync("_FilterBar", (FilterBarVM)ViewBag.Filter)
  <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th>Mã TK</th><th>Họ tên</th><th>Tên đăng nhập</th><th>Email</th><th>Vai trò</th><th>Đăng nhập gần nhất</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
      <tbody>
      @foreach (var t in Model.Items)
      {
        <tr>
          <td><a class="code" asp-action="Edit" asp-route-id="@t.MaTaiKhoan">@UiHelper.MaTK(t.MaTaiKhoan)</a></td>
          <td>@UiHelper.TenChuaAvatar(t.HoTen)</td>
          <td>@t.TenDangNhap</td>
          <td>@t.Email</td>
          <td>@VaiTroConst.Ten(t.VaiTro)</td>
          <td>@(t.LanDangNhapCuoi != null ? UiHelper.NgayGio(t.LanDangNhapCuoi.Value) : "—")</td>
          <td>@UiHelper.Badge(t.TrangThai ? "Hoạt động" : "Đã khóa")</td>
          <td><div class="acts">
            <a class="ico" asp-action="Edit" asp-route-id="@t.MaTaiKhoan" title="Sửa"><i class="bi bi-pencil"></i></a>
            @if (t.MaTaiKhoan != toi)
            {
              <form asp-action="Delete" asp-route-id="@t.MaTaiKhoan" method="post" class="d-inline" onsubmit="return confirm('Xóa tài khoản @t.TenDangNhap?');">
                <button class="ico del" title="Xóa"><i class="bi bi-trash3"></i></button></form>
            }
          </div></td>
        </tr>
      }
      @if (!Model.Items.Any()) { <tr><td colspan="8" class="empty">Không có tài khoản phù hợp</td></tr> }
      </tbody>
    </table>
  </div>
  <partial name="_PhanTrang" model="Model" />
</div>
