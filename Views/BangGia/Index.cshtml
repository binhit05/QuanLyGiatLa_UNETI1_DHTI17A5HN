@model QuanLyGiatLa_UNETI1_DHTI17A5HN.Helpers.PaginatedList<QuanLyGiatLa_UNETI1_DHTI17A5HN.Models.BangGiaDichVu>

@{
    ViewData["Title"] = "Quản lý Bảng giá dịch vụ";
}

<h2 class="my-3">Danh Sách Bảng Giá Dịch Vụ</h2>

<div class="row mb-3">
    <div class="col-md-6">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Thêm bảng giá mới
        </a>
    </div>
    <div class="col-md-6">
        <form asp-action="Index" method="get" class="d-flex">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control me-2" placeholder="Tìm theo tên dịch vụ..." />
            <button type="submit" class="btn btn-outline-secondary">Tìm kiếm</button>
        </form>
    </div>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Mã BG</th>
            <th>Tên Dịch Vụ</th>
            <th>Đơn Giá</th>
            <th>Ngày Áp Dụng</th>
            <th>Ngày Kết Thúc</th>
            <th>Trạng Thái</th>
            <th class="text-center">Thao Tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaBangGia</td>
                    <td>@(item.DichVu != null ? item.DichVu.TenDichVu : "N/A")</td>
                    <td>@item.DonGia.ToString("N0") VNĐ</td>
                    <td>@item.NgayApDung.ToString("dd/MM/yyyy")</td>
                    <td>@(item.NgayKetThuc.HasValue ? item.NgayKetThuc.Value.ToString("dd/MM/yyyy") : "—")</td>
                    <td>
                        @if (item.TrangThai)
                        {
                            <span class="badge bg-success">Đang áp dụng</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Ngưng áp dụng</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.MaBangGia" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Details" asp-route-id="@item.MaBangGia" class="btn btn-sm btn-info text-white">Chi tiết</a>
                        <a asp-action="Delete" asp-route-id="@item.MaBangGia" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted">Không có dữ liệu bảng giá nào.</td>
            </tr>
        }
    </tbody>
</table>

<!-- Phân trang -->
@{
    var prevDisabled = (Model != null && !Model.HasPreviousPage) ? "disabled" : "";
    var nextDisabled = (Model != null && !Model.HasNextPage) ? "disabled" : "";
    var pageIndex = Model != null ? Model.PageIndex : 1;
    var totalPages = Model != null ? Model.TotalPages : 1;
}

<div class="d-flex justify-content-between align-items-center mt-3">
    <div>Trang @pageIndex / @totalPages</div>
    <div>
        <a asp-action="Index"
           asp-route-pageNumber="@(pageIndex - 1)"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn btn-outline-primary btn-sm @prevDisabled">
            Trang trước
        </a>
        <a asp-action="Index"
           asp-route-pageNumber="@(pageIndex + 1)"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn btn-outline-primary btn-sm @nextDisabled">
            Trang sau
        </a>
    </div>
</div>