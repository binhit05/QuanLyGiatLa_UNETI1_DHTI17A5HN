@* Họ và tên: Lê Hoàng Anh | Mã sinh viên: 23103100214 | Nội dung thực hiện: Giao diện trang GiaoTra/Edit. *@
@model GiaoTra
@{ ViewData["Title"] = "Sửa thông tin giao trả"; var hinhThucs = new[] { "Nhận tại cửa hàng", "Giao tận nơi" }; }
<a class="back-link" asp-action="Index"><i class="bi bi-chevron-left"></i> Giao trả đồ</a>
<div class="page-head"><div><h1>Thông tin giao trả — @(UiHelper.MaDon(Model.DonGiat!))</h1><p>Khách hàng: @(Model.DonGiat!.KhachHang?.HoTen) · Giao lúc @UiHelper.NgayGio(Model.NgayGiaoTra) bởi @Model.NguoiGiao</p></div></div>
<form asp-action="Edit" method="post">
  <input type="hidden" name="maDonGiat" value="@Model.MaDonGiat" />
  <div class="form-sec" style="max-width:820px">
    <div class="fgrid two">
      <div><label class="flabel">Người nhận *</label><input name="nguoiNhan" class="finput" value="@Model.NguoiNhan" required maxlength="100" /></div>
      <div><label class="flabel">Hình thức</label><select name="hinhThucNhan" class="fselect">@foreach (var h in hinhThucs) { <option value="@h" selected="@(Model.HinhThucNhan == h)">@h</option> }</select></div>
      <div class="full"><label class="flabel">Ghi chú</label><input name="ghiChu" class="finput" value="@Model.GhiChu" maxlength="300" /></div>
    </div>
    <div class="d-flex gap-2 mt-3"><button class="btn btn-primary"><i class="bi bi-check2"></i>Lưu</button><a class="btn btn-white" asp-action="Index">Hủy</a></div>
  </div>
</form>
