@* Họ và tên: Lê Hoàng Anh | Mã sinh viên: 23103100214 | Nội dung thực hiện: Giao diện trang GiaoTra/Create. *@
@model GiaoTraVM
@{
    ViewData["Title"] = "Ghi nhận giao trả";
    var dons = (List<Opt>)ViewBag.Dons;
    var hinhThucs = new[] { "Nhận tại cửa hàng", "Giao tận nơi" };
}
<a class="back-link" asp-action="Index"><i class="bi bi-chevron-left"></i> Giao trả đồ</a>
<div class="page-head"><div><h1>Ghi nhận giao trả</h1><p>Chỉ giao trả được đơn ở trạng thái Chờ giao trả và đã thanh toán đủ.</p></div></div>
<form asp-action="Create" method="post">
  <div asp-validation-summary="All" class="alert alert-danger"></div>
  <div class="form-sec" style="max-width:820px">
    <div class="fgrid two">
      <div class="full"><label class="flabel">Đơn giặt *</label>
        <select asp-for="MaDonGiat" class="fselect"><option value="0">-- Chọn đơn giặt --</option>@foreach (var o in dons) { <option value="@o.Value">@o.Text</option> }</select></div>
      <div><label class="flabel">Ngày giao trả *</label><input type="datetime-local" name="NgayGiaoTra" class="finput" value="@Model.NgayGiaoTra.ToString("yyyy-MM-ddTHH:mm")" /></div>
      <div><label class="flabel">Hình thức</label><select asp-for="HinhThucNhan" class="fselect">@foreach (var h in hinhThucs) { <option value="@h">@h</option> }</select></div>
      <div><label class="flabel">Người giao</label><input asp-for="NguoiGiao" class="finput" /></div>
      <div><label class="flabel">Người nhận *</label><input asp-for="NguoiNhan" class="finput" /><span asp-validation-for="NguoiNhan" class="ferr"></span></div>
      <div class="full"><label class="flabel">Ghi chú</label><input asp-for="GhiChu" class="finput" /></div>
    </div>
    <div class="d-flex gap-2 mt-3"><button class="btn btn-primary"><i class="bi bi-check2"></i>Xác nhận giao trả</button><a class="btn btn-white" asp-action="Index">Hủy</a></div>
  </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
