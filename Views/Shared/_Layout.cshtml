@* Họ và tên: Trần Văn Bình | Mã sinh viên: 23103100179 | Nội dung thực hiện: Khung giao diện chung: sidebar, thanh trên, menu theo vai trò (việc nhóm trưởng). *@
@inject QuanLyGiatLa_UNETI1_DHTI17A5HN.Data.AppDbContext Db
@{
    var vaiTro = Context.Session.LayVaiTro();
    var hoTen = Context.Session.LayHoTen() ?? "";
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool admin = vaiTro == VaiTroConst.Admin;
    bool tiepNhan = vaiTro == VaiTroConst.NhanVienTiepNhan;
    bool xuLy = vaiTro == VaiTroConst.NhanVienXuLy;
    string On(bool b) => b ? "active" : "";
    int soDon = Db.DonGiats.Count();
    int soKn = Db.KhieuNais.Count(k => k.TrangThai != "Đã giải quyết");
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - CleanGo Laundry</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand">
      <span class="logo-box"><i class="bi bi-basket2-fill"></i></span>
      <div><div class="brand-name">CleanGo</div><div class="brand-sub">LAUNDRY MANAGER</div></div>
    </div>
    <div class="menu-title">QUẢN LÝ CHUNG</div>
    <nav class="menu">
      <a class="@On(ctrl == "ThongKe" && act == "Index")" asp-controller="ThongKe" asp-action="Index"><i class="bi bi-grid"></i> Tổng quan</a>
      <a class="@On(ctrl == "DonGiat")" asp-controller="DonGiat" asp-action="Index"><i class="bi bi-file-earmark-text"></i> Đơn giặt <span class="cnt">@soDon</span></a>
      @if (admin || tiepNhan)
      {
        <a class="@On(ctrl == "KhachHang")" asp-controller="KhachHang" asp-action="Index"><i class="bi bi-people"></i> Khách hàng</a>
      }
      @if (admin)
      {
        <a class="@On(ctrl == "DichVu" || ctrl == "BangGia")" asp-controller="DichVu" asp-action="Index"><i class="bi bi-tags"></i> Dịch vụ &amp; bảng giá</a>
        <a class="@On(ctrl == "NhanVien")" asp-controller="NhanVien" asp-action="Index"><i class="bi bi-briefcase"></i> Nhân viên</a>
      }
      @if (admin || xuLy)
      {
        <a class="@On(ctrl == "PhanCong")" asp-controller="PhanCong" asp-action="Index"><i class="bi bi-clipboard-check"></i> Phân công &amp; xử lý</a>
      }
      @if (admin || tiepNhan)
      {
        <a class="@On(ctrl == "GiaoTra")" asp-controller="GiaoTra" asp-action="Index"><i class="bi bi-truck"></i> Giao trả đồ</a>
        <a class="@On(ctrl == "ThanhToan")" asp-controller="ThanhToan" asp-action="Index"><i class="bi bi-wallet2"></i> Thanh toán</a>
        <a class="@On(ctrl == "KhieuNai")" asp-controller="KhieuNai" asp-action="Index"><i class="bi bi-headset"></i> Khiếu nại @if (soKn > 0) { <span class="cnt red">@soKn</span> }</a>
      }
      @if (admin)
      {
        <a class="@On(ctrl == "DanhMuc")" asp-controller="DanhMuc" asp-action="Index"><i class="bi bi-diagram-3"></i> Danh mục</a>
        <a class="@On(ctrl == "TaiKhoan")" asp-controller="TaiKhoan" asp-action="Index"><i class="bi bi-person-gear"></i> Tài khoản</a>
        <a class="@On(ctrl == "ThongKe" && act == "BaoCao")" asp-controller="ThongKe" asp-action="BaoCao"><i class="bi bi-bar-chart-line"></i> Thống kê báo cáo</a>
      }
    </nav>
    <div class="support">
      <div class="t"><i class="bi bi-headset"></i><div><div class="fw-bold">Cần hỗ trợ?</div><div class="small text-muted">Liên hệ bộ phận kỹ thuật</div></div></div>
      <div class="phone">0987188328</div>
    </div>
    <div class="ver">CleanGo v1.0.0</div>
  </aside>

  <div class="main">
    <header class="topbar">
      <div class="crumb">CleanGo &nbsp;<i class="bi bi-chevron-right small"></i>&nbsp; <b>@ViewData["Title"]</b></div>
      <div class="top-right">
        <span class="bell"><i class="bi bi-bell"></i></span>
        <div class="user-chip">
          <span class="av2">@UiHelper.VietTat(hoTen)</span>
          <div><small>Xin chào,</small><div class="fw-bold">@hoTen <small>(@VaiTroConst.Ten(vaiTro))</small></div></div>
        </div>
        <a class="btn-out" asp-controller="TaiKhoan" asp-action="DangXuat"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a>
      </div>
    </header>
    <main class="content">
      @if (TempData["Msg"] != null) { <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@TempData["Msg"]</div> }
      @if (TempData["Loi"] != null) { <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Loi"]</div> }
      @RenderBody()
    </main>
  </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
