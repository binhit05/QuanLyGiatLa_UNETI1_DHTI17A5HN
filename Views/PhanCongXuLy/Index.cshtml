@model IEnumerable<QuanLyGiatLa_UNETI1_DHTI17A5HN.Models.PhanCongXuLy>

@{
    ViewData["Title"] = "Quản lý phân công xử lý";
}

<h2>Quản lý phân công xử lý</h2>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success">
        @TempData["ThongBao"]
    </div>
}

@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger">
        @TempData["Loi"]
    </div>
}

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Mã phân công</th>
            <th>Mã đơn giặt</th>
            <th>Mã nhân viên</th>
            <th>Ngày phân công</th>
            <th>Nội dung công việc</th>
            <th>Trạng thái</th>
            <th>Ghi chú</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaPhanCong</td>
                    <td>@item.MaDonGiat</td>
                    <td>@item.MaNhanVien</td>
                    <td>@item.NgayPhanCong.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.NoiDungCongViec</td>
                    <td>@item.TrangThai</td>
                    <td>@(item.GhiChu ?? "-")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">
                    Chưa có dữ liệu phân công.
                </td>
            </tr>
        }
    </tbody>
</table>
