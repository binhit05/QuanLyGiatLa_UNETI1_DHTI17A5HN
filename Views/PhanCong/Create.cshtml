@* Họ và tên: Lê Hoàng Anh | Mã sinh viên: 23103100214 | Nội dung thực hiện: Giao diện trang PhanCong/Create. *@
@model PhanCongVM
@{
    ViewData["Title"] = "Phân công mới";
    var dons = (List<Opt>)ViewBag.Dons;
    var nvs = (List<NhanVien>)ViewBag.NhanViens;
}
<a class="back-link" asp-action="Index"><i class="bi bi-chevron-left"></i> Phân công &amp; theo dõi xử lý</a>
<div class="page-head"><div><h1>Phân công mới</h1><p>Chỉ hiển thị đơn đã xác nhận hoặc đang xử lý và chưa có người phụ trách.</p></div></div>
<form asp-action="Create" method="post">
  <div asp-validation-summary="All" class="alert alert-danger"></div>
  <div class="form-sec" style="max-width:820px">
    <div class="fgrid two">
      <div class="full"><label class="flabel">Đơn giặt *</label>
        <select asp-for="MaDonGiat" class="fselect"><option value="0">-- Chọn đơn giặt --</option>
          @foreach (var o in dons) { <option value="@o.Value">@o.Text</option> }</select></div>
      <div><label class="flabel">Nhân viên xử lý *</label>
        <select asp-for="MaNhanVien" class="fselect"><option value="0">-- Chọn nhân viên --</option>
          @foreach (var n in nvs) { <option value="@n.MaNhanVien">@n.HoTen</option> }</select></div>
      <div><label class="flabel">Nội dung công việc</label><input asp-for="NoiDungCongViec" class="finput" placeholder="Ví dụ: Xử lý vết bẩn áo vest" /></div>
    </div>
    <div class="note-warn mt-3"><i class="bi bi-info-circle"></i><span>Hệ thống tự tạo 6 công đoạn: Phân loại, Xử lý vết bẩn, Giặt / hấp, Sấy khô, Là / ủi, Kiểm tra &amp; đóng gói.</span></div>
    <div class="d-flex gap-2 mt-3"><button class="btn btn-primary"><i class="bi bi-check2"></i>Phân công</button><a class="btn btn-white" asp-action="Index">Hủy</a></div>
  </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
