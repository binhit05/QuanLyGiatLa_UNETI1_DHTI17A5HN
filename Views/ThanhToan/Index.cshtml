@* Họ và tên: Lê Duy Khánh | Mã sinh viên: 23103100216 | Nội dung thực hiện: Giao diện trang ThanhToan/Index. *@
@model PagedList<DonGiat>
@{ ViewData["Title"] = "Quản lý thanh toán"; bool admin = Context.Session.LayVaiTro() == VaiTroConst.Admin; }
<div class="page-head">
  <div><h1>Quản lý thanh toán</h1><p>Ghi nhận và đối soát các khoản thanh toán của đơn giặt.</p></div>
  <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i>Ghi nhận thanh toán</a>
</div>
<div class="panel">
  @await Html.PartialAsync("_FilterBar", (FilterBarVM)ViewBag.Filter)
  <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th>Mã TT</th><th>Mã đơn</th><th>Khách hàng</th><th>Phương thức</th><th>Tổng tiền</th><th>Đã trả</th><th>Còn lại</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
      <tbody>
      @foreach (var d in Model.Items)
      {
        var cuoi = d.ThanhToans.OrderByDescending(t => t.NgayThanhToan).FirstOrDefault();
        <tr>
          <td><a class="code" asp-action="ChiTiet" asp-route-id="@d.MaDonGiat">@UiHelper.MaTT(d.MaDonGiat)</a></td>
          <td><a class="code" asp-controller="DonGiat" asp-action="Details" asp-route-id="@d.MaDonGiat">@UiHelper.MaDon(d)</a></td>
          <td>@UiHelper.TenChuaAvatar(d.KhachHang?.HoTen)</td>
          <td>@(cuoi?.PhuongThuc ?? "—")</td>
          <td class="num">@UiHelper.Tien(d.TongTienDuKien)</td>
          <td class="num">@UiHelper.Tien(d.DaThanhToan)</td>
          <td class="num">@UiHelper.Tien(d.ConLai)</td>
          <td>@UiHelper.Badge(d.TrangThaiThanhToan)</td>
          <td><div class="acts">
            <a class="ico" asp-action="ChiTiet" asp-route-id="@d.MaDonGiat" title="Xem các khoản thanh toán"><i class="bi bi-pencil"></i></a>
            @if (admin && d.ThanhToans.Any() && d.TrangThai != TrangThaiDon.HoanThanh)
            {
              <form asp-action="XoaTatCa" asp-route-id="@d.MaDonGiat" method="post" class="d-inline" onsubmit="return confirm('Xóa toàn bộ khoản thanh toán của đơn @UiHelper.MaDon(d)?');">
                <button class="ico del" title="Xóa các khoản thanh toán"><i class="bi bi-trash3"></i></button></form>
            }
          </div></td>
        </tr>
      }
      @if (!Model.Items.Any()) { <tr><td colspan="9" class="empty">Không có dữ liệu phù hợp</td></tr> }
      </tbody>
    </table>
  </div>
  <partial name="_PhanTrang" model="Model" />
</div>
